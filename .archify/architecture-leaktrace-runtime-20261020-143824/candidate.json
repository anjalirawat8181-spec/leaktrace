  "cards": [
    {
      "dot": "emerald", "title": "Primary path",
      "items": [
        "Controller generates: the API inserts one copy per seat and enqueues one message per room",
        "The worker polls Postgres, renders each copy, merges the room and writes ./data/papers/<exam>/<centre>/<room>.pdf",
        "A superintendent download passes the window check, then receives 120 s signed links"
      ]
    },
    {
      "dot": "rose", "title": "Trust boundaries",
      "items": [
        "Browser is untrusted: httpOnly SameSite=Strict JWT cookie, 8 h",
        "API enforces requireAuth and requireRole on its routes; bodies are zod-validated",
        "Signed file links are HMAC-checked; expired or tampered tokens get 403",
        "The worker has no inbound port and reaches only Postgres and ./data"
      ]
    },
    {
      "dot": "cyan", "title": "Inside the API process",
      "items": [
        "Scheduler poller moves due schedules to the exam-events queue every 10 s",
        "Exam-events consumer sets RELEASED or CLOSED and publishes release notices",
        "Demo-set zips and trace analysis run inside API requests"
      ]
    },
    {
      "dot": "amber", "title": "External dependencies",
      "items": [
        "PostgreSQL holds data, queue, schedules, notifications and worker heartbeats",
        "Local disk holds papers and evidence photos, shared by API and worker",
        "No AWS code exists yet: createAdapters('aws') throws"
      ]
    },
    {
      "dot": "violet", "title": "Adapter seam",
      "items": [
        "Storage, queue, scheduler, notifier, metrics, config and fleet sit behind packages/adapters",
        "Mode 'local' is hard-coded in apps/api/src/adapters.ts and apps/worker/src/main.ts"
      ]
    }
  ]
